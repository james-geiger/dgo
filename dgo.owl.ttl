@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dgo: <https://w3id.org/dgo/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix ns1: <http://purl.org/ontology/bibo/> .
@prefix ns2: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdfs:label a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "label" ;
    ns2:IAO_0000115 "Words" ;
    skos:inScheme dgo:core .

dgo: a owl:Ontology ;
    rdfs:label "data_governance_ontology" ;
    ns2:IAO_0000115 "An ontology for data governance: business terms, subject areas,  stewardship roles and responsibilities, term-lifecycle status, data classification, and semantic typing." ;
    dcterms:bibliographicCitation "Geiger, J.M. (2026). An ontology for data governance. Data Governance ontology, v0.1.0. https://w3id.org/dgo/" ;
    dcterms:created "2026-09-24" ;
    dcterms:creator "James Geiger" ;
    dcterms:description "An ontology for data governance: business terms, subject areas,  stewardship roles and responsibilities, term-lifecycle status, data classification, and semantic typing." ;
    dcterms:issued "2026-09-24" ;
    dcterms:license "https://w3id.org/dgo/LICENSE" ;
    dcterms:publisher "James Geiger" ;
    dcterms:title "Data Governance Ontology" ;
    ns1:status "specification draft" ;
    pav:version "0.1.0" ;
    vann:preferredNamespacePrefix "dgo" ;
    vann:preferredNamespaceUri "https://w3id.org/dgo/" ;
    owl:imports ns2:bfo.owl,
        ns2:iao.owl ;
    owl:versionInfo "0.1.0" .

dgo:DGO_00000001 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "data governance council" ;
    ns2:IAO_0000115 "Description." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom dgo:DataGovernance ;
            owl:onProperty ns2:RO_0000056 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ns2:RO_0002351 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ns2:RO_0000056 ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( dgo:Person dgo:Organization ) ] ;
            owl:onProperty ns2:RO_0002351 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:RO_0000056 ],
        ns2:BFO_0000027 ;
    skos:exactMatch dgo:DataGovernanceCouncil ;
    skos:inScheme dgo:management .

dgo:id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "id" ;
    ns2:IAO_0000115 "The term's globally unique, persistent IRI. Its stable identity." ;
    rdfs:range linkml:Uriorcurie ;
    skos:inScheme dgo:core .

ns2:BFO_0000015 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "process" ;
    skos:exactMatch dgo:Process ;
    skos:inScheme dgo:management .

ns2:BFO_0000030 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "object" ;
    skos:exactMatch dgo:Object ;
    skos:inScheme dgo:management .

ns2:BFO_0000023 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "role" ;
    skos:exactMatch dgo:Role ;
    skos:inScheme dgo:management .

ns2:BFO_0000027 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "object aggregate" ;
    skos:exactMatch dgo:ObjectAggregate ;
    skos:inScheme dgo:management .

ns2:RO_0002351 a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_member" ;
    ns2:IAO_0000115 "A person or organization that is a member of this council." ;
    rdfs:range [ owl:unionOf ( dgo:Person dgo:Organization ) ] ;
    skos:inScheme dgo:management .

dgo:DGO_00000003 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "chair" ;
    ns2:IAO_0000115 "Convenes the council and owns final sign-off on decisions." ;
    rdfs:subClassOf dgo:DGO_00000002 ;
    skos:exactMatch dgo:Chair ;
    skos:inScheme dgo:management .

dgo:DGO_00000004 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "security steward" ;
    ns2:IAO_0000115 "Advises on access controls and safeguarding of the data." ;
    rdfs:subClassOf dgo:DGO_00000002 ;
    skos:exactMatch dgo:SecuritySteward ;
    skos:inScheme dgo:management .

dgo:DGO_00000005 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ethics steward" ;
    ns2:IAO_0000115 "Advises on ethical use and transparency across the organization." ;
    rdfs:subClassOf dgo:DGO_00000002 ;
    skos:exactMatch dgo:EthicsSteward ;
    skos:inScheme dgo:management .

dgo:DGO_00000006 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "documentation steward" ;
    ns2:IAO_0000115 "Keeps definitions, lineage, and decisions documented." ;
    rdfs:subClassOf dgo:DGO_00000002 ;
    skos:exactMatch dgo:DocumentationSteward ;
    skos:inScheme dgo:management .

dgo:DGO_00000007 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "compliance steward" ;
    ns2:IAO_0000115 "Advises on regulatory and policy conformance." ;
    rdfs:subClassOf dgo:DGO_00000002 ;
    skos:exactMatch dgo:ComplianceSteward ;
    skos:inScheme dgo:management .

dgo:DGO_00000009 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "owner" ;
    ns2:IAO_0000115 "Accountable for approving data definition." ;
    rdfs:subClassOf dgo:DGO_00000008 ;
    skos:exactMatch dgo:Owner ;
    skos:inScheme dgo:management .

dgo:DGO_00000010 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "steward" ;
    ns2:IAO_0000115 "Responsible for quality of implementing data." ;
    rdfs:subClassOf dgo:DGO_00000008 ;
    skos:exactMatch dgo:Steward ;
    skos:inScheme dgo:management .

dgo:DGO_00000011 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "custodian" ;
    ns2:IAO_0000115 "Consulted on the collection, storage, and management of data." ;
    rdfs:subClassOf dgo:DGO_00000008 ;
    skos:exactMatch dgo:Custodian ;
    skos:inScheme dgo:management .

dgo:DGO_00000012 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "subject matter expert" ;
    ns2:IAO_0000115 "Consulted on meaning and use of data in practice." ;
    rdfs:subClassOf dgo:DGO_00000008 ;
    skos:exactMatch dgo:SubjectMatterExpert ;
    skos:inScheme dgo:management .

ns2:BFO_0000050 a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "part_of" ;
    ns2:IAO_0000115 "A larger governance process this one is a part of." ;
    rdfs:range dgo:DataGovernance ;
    skos:inScheme dgo:management .

ns2:RO_0000056 a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "participates_in" ;
    ns2:IAO_0000115 "The data governance process this council carries out." ;
    rdfs:range dgo:DataGovernance ;
    skos:inScheme dgo:management .

dgo:Organization a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "organization" ;
    ns2:IAO_0000115 "A group of people organized for a governance purpose, e.g. a council or office." ;
    rdfs:subClassOf ns2:BFO_0000027 ;
    skos:inScheme dgo:management .

dgo:Person a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "person" ;
    rdfs:subClassOf ns2:BFO_0000030 ;
    skos:exactMatch ns2:NCBITaxon_9606 ;
    skos:inScheme dgo:management .

ns2:BFO_0000055 a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "realized_in" ;
    ns2:IAO_0000115 "The governance process in which this role is realized." ;
    rdfs:range dgo:DataGovernance ;
    skos:inScheme dgo:management .

ns2:RO_0000081 a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "role_of" ;
    ns2:IAO_0000115 "The council member (person or organization) that bears this role." ;
    rdfs:range [ owl:unionOf ( dgo:Person dgo:Organization ) ] ;
    skos:inScheme dgo:management .

dgo:DGO_00000008 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "governance role" ;
    ns2:IAO_0000115 "What an individual or entity is responsible for with respect to a managed term." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( dgo:Person dgo:Organization ) ] ;
            owl:onProperty ns2:RO_0000081 ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty rdf:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:BFO_0000055 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty rdf:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty rdf:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ns2:BFO_0000055 ],
        [ a owl:Restriction ;
            owl:allValuesFrom dgo:DataGovernance ;
            owl:onProperty ns2:BFO_0000055 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ns2:RO_0000081 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:RO_0000081 ],
        ns2:BFO_0000023 ;
    skos:exactMatch dgo:GovernanceRole ;
    skos:inScheme dgo:management .

dgo:DGO_00000002 a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "council role" ;
    ns2:IAO_0000115 "What facet of stewardship the holder is responsible for on a Governance Council." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty rdf:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:RO_0000081 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:BFO_0000055 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ns2:BFO_0000055 ],
        [ a owl:Restriction ;
            owl:allValuesFrom dgo:DataGovernance ;
            owl:onProperty ns2:BFO_0000055 ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( dgo:Person dgo:Organization ) ] ;
            owl:onProperty ns2:RO_0000081 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty rdf:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ns2:RO_0000081 ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty rdf:type ],
        ns2:BFO_0000023 ;
    skos:exactMatch dgo:CouncilRole ;
    skos:inScheme dgo:management .

dgo:DataGovernance a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "data governance" ;
    ns2:IAO_0000115 "Words!" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom dgo:DataGovernance ;
            owl:onProperty ns2:BFO_0000050 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ns2:BFO_0000050 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ns2:BFO_0000050 ],
        ns2:BFO_0000015 ;
    skos:inScheme dgo:management .

rdf:type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "type" ;
    ns2:IAO_0000115 "The specific subclass this object instantiates, given as its class IRI (e.g. a chair). Lets instance data name a subclass; emitted as rdf:type." ;
    rdfs:range linkml:Uriorcurie ;
    skos:inScheme dgo:core .

[] a owl:Restriction ;
    rdfs:subClassOf dgo:DGO_00000006 ;
    owl:onProperty rdf:type ;
    owl:someValuesFrom dgo:DGO_00000006 .

[] a owl:Restriction ;
    rdfs:subClassOf dgo:DGO_00000003 ;
    owl:onProperty rdf:type ;
    owl:someValuesFrom dgo:DGO_00000003 .

[] a owl:Restriction ;
    rdfs:subClassOf dgo:DGO_00000009 ;
    owl:onProperty rdf:type ;
    owl:someValuesFrom dgo:DGO_00000009 .

[] a owl:Restriction ;
    rdfs:subClassOf dgo:DGO_00000010 ;
    owl:onProperty rdf:type ;
    owl:someValuesFrom dgo:DGO_00000010 .

[] a owl:Restriction ;
    rdfs:subClassOf dgo:DGO_00000004 ;
    owl:onProperty rdf:type ;
    owl:someValuesFrom dgo:DGO_00000004 .

[] a owl:Restriction ;
    rdfs:subClassOf dgo:DGO_00000008 ;
    owl:onProperty rdf:type ;
    owl:someValuesFrom dgo:DGO_00000008 .

[] a owl:Restriction ;
    rdfs:subClassOf dgo:DGO_00000012 ;
    owl:onProperty rdf:type ;
    owl:someValuesFrom dgo:DGO_00000012 .

[] a owl:Restriction ;
    rdfs:subClassOf dgo:DGO_00000007 ;
    owl:onProperty rdf:type ;
    owl:someValuesFrom dgo:DGO_00000007 .

[] a owl:Restriction ;
    rdfs:subClassOf dgo:DGO_00000005 ;
    owl:onProperty rdf:type ;
    owl:someValuesFrom dgo:DGO_00000005 .

[] a owl:Restriction ;
    rdfs:subClassOf dgo:DGO_00000002 ;
    owl:onProperty rdf:type ;
    owl:someValuesFrom dgo:DGO_00000002 .

[] a owl:Restriction ;
    rdfs:subClassOf dgo:DGO_00000011 ;
    owl:onProperty rdf:type ;
    owl:someValuesFrom dgo:DGO_00000011 .

